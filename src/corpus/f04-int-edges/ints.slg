// f04-int-edges pins: `Int` is exact where a machine word is not. Values
// beyond 2^53 (where a double loses integers), beyond 2^63 and 2^64 (where a
// 64-bit word wraps), up to the engine's own bound of 2^127 - 1; `+ - *` and
// `^`, unary minus, precedence, hex and `_` in literals, number printing.
// A backend that computes with a double or a wrapping word fails these rows.

const two53: Int = 9007199254740992;
const two63: Int = 9223372036854775808;
const two64: Int = 18446744073709551616;
const top: Int = 170141183460469231731687303715884105727;

@cases(
  (9007199254740992, 1) -> 9007199254740993,
  (9007199254740993, 1) -> 9007199254740994,
  (9223372036854775807, 1) -> 9223372036854775808,
  (18446744073709551615, 1) -> 18446744073709551616,
  (-9223372036854775808, -1) -> -9223372036854775809,
  (170141183460469231731687303715884105726, 1) -> 170141183460469231731687303715884105727,
  (-170141183460469231731687303715884105726, -1) -> -170141183460469231731687303715884105727,
)
pub fn add(a: Int, b: Int) -> Int = a + b;

@cases(
  (9007199254740993, 9007199254740992) -> 1,
  (0, 9223372036854775808) -> -9223372036854775808,
  (-9223372036854775808, 1) -> -9223372036854775809,
  (18446744073709551616, 18446744073709551615) -> 1,
)
pub fn sub(a: Int, b: Int) -> Int = a - b;

@cases(
  (3037000500, 3037000500) -> 9223372037000250000,
  (4294967296, 4294967296) -> 18446744073709551616,
  (9007199254740993, 3) -> 27021597764222979,
  (94906267, 94906267) -> 9007199515875289,
  (-9223372036854775808, -1) -> 9223372036854775808,
  (9223372036854775807, 9223372036854775807) -> 85070591730234615847396907784232501249,
  (13043817825332782212, 13043817825332782212) -> 170141183460469231722567801800623612944,
  (-1, 170141183460469231731687303715884105727) -> -170141183460469231731687303715884105727,
)
pub fn mul(a: Int, b: Int) -> Int = a * b;

@cases(
  (2, 0) -> 1,
  (0, 0) -> 1,
  (2, 10) -> 1024,
  (2, 53) -> 9007199254740992,
  (2, 63) -> 9223372036854775808,
  (2, 64) -> 18446744073709551616,
  (2, 100) -> 1267650600228229401496703205376,
  (2, 126) -> 85070591730234615865843651857942052864,
  (3, 40) -> 12157665459056928801,
  (10, 38) -> 100000000000000000000000000000000000000,
  (-2, 3) -> -8,
  (-2, 64) -> 18446744073709551616,
  (-3, 79) -> -49269609804781974438694403402127765867,
  (7, 1) -> 7,
)
pub fn pow(a: Int, n: Int) -> Int = a ^ n;

@cases(
  9007199254740993 -> "9007199254740993",
  -9223372036854775809 -> "-9223372036854775809",
  170141183460469231731687303715884105727 -> "170141183460469231731687303715884105727",
  0 -> "0",
  -0 -> "0",
)
pub fn show(n: Int) -> Text = "{n}";

test neighbours_stay_apart_past_a_double = {
  assert two53 + 1 != two53;
  assert two53 + 1 > two53;
  assert two53 + 2 - (two53 + 1) == 1;
  assert (two53 + 1) * 2 == 18014398509481986;
  assert [two53 + 1, two53, two53 + 2].sort() == [two53, two53 + 1, two53 + 2];
  assert Set(two53, two53 + 1, two53 + 2).size == 3;
}

test nothing_wraps_at_a_word = {
  assert two63 > 0;
  assert two63 - 1 == 9223372036854775807;
  assert 0 - two63 - 1 < 0 - two63;
  assert two64 > two63;
  assert two64 - 1 == 18446744073709551615;
  assert two63 + two63 == two64;
  assert two64 * (two63 - 1) + (two64 - 1) == top;
  assert (two64 - 1) * (two63 - 1) == 170141183460469231704017187605319778305;
}

test the_engine_top_is_reachable = {
  assert top == 2 ^ 126 - 1 + 2 ^ 126;
  assert top - 1 + 1 == top;
  assert 0 - top - 1 < 0 - top;
  assert 0 - top - 1 + top == -1;
  assert top mod 2 == 1 and top mod two64 == two64 - 1;
}

test signs_and_precedence = {
  assert -2 ^ 2 == -4;
  assert (-2) ^ 2 == 4;
  assert 2 + 3 * 4 == 14;
  assert (2 + 3) * 4 == 20;
  assert 2 * 3 ^ 2 == 18;
  assert 2 ^ 3 ^ 2 == 512;
  assert 10 - 4 - 3 == 3;
  assert - -5 == 5;
  assert 1 - -1 == 2;
  assert 7 - 2 * 3 mod 4 == 5;
}

test literal_spellings = {
  assert 0xff == 255;
  assert 0xFFFF_FFFF_FFFF_FFFF == two64 - 1;
  assert 1_000_000 == 1000000;
  assert 0x20_0000_0000_0000 == two53;
}

test sums_and_products_pass_the_word(a: 4294967296..=9223372036854775808, b: 4294967296..=9223372036854775808) = {
  assert a + b - b == a;
  assert a * b >= two64;
  assert (a * b - a) == a * (b - 1);
  assert a * b == b * a;
  assert (a + 1) * (a - 1) == a * a - 1;
}

test squares_are_exact(n: 3037000499..=13043817825332782211) = {
  assert (n + 1) * (n + 1) - n * n == 2 * n + 1;
  assert n * n > n;
  assert (n * n) mod n == 0;
}
