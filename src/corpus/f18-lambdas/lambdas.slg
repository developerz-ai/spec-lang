// f18-lambdas pins: `it` for one unnested argument, `x => expr`, two
// arguments `(a, x) => expr`, a block body `x => { ...; return v; }`, lambdas
// that read locals, parameters, constants and state around them, a lambda
// inside a lambda with named arguments, and `it` binding to the nearest
// library call that takes a function (the engine's open choice 13).

type Line(sku: Text, qty: Int, cents: Int);

const vat: Int = 19;
state discount: Int = 0;

fn double(n: Int) -> Int = n * 2;

fn cost(l: Line) -> Int = l.qty * l.cents;

@cases([1, 2, 3] -> [2, 4, 6], [] -> [])
pub fn with_it(xs: List[Int]) -> List[Int] = xs.map(it * 2);

@cases([1, 2, 3] -> [2, 4, 6])
pub fn with_name(xs: List[Int]) -> List[Int] = xs.map(x => x * 2);

@cases([1, 2, 3] -> [2, 4, 6])
pub fn through_a_fn(xs: List[Int]) -> List[Int] = xs.map(double(it));

@cases(([1, 2, 3], 10) -> [11, 12, 13], ([], 1) -> [])
pub fn reads_a_parameter(xs: List[Int], by: Int) -> List[Int] = xs.map(it + by);

@cases([1, 2] -> [100, 219])
pub fn reads_a_constant(xs: List[Int]) -> List[Int] = xs.map(it * (100 + vat)).map(n => n - vat);

@cases([5, -3, 8] -> [5, 0, 8], [] -> [])
pub fn with_a_block(xs: List[Int]) -> List[Int] = xs.map(x => {
  if x < 0 { return 0; }
  let kept = x;
  return kept;
});

@cases([1, 2, 3, 4] -> 24, [] -> 1)
pub fn product(xs: List[Int]) -> Int = xs.fold(1, (acc, x) => acc * x);

@cases(3 -> [(1, 1), (2, 1), (2, 2), (3, 1), (3, 2), (3, 3)], 0 -> [])
pub fn triangle(n: Int) -> List[(Int, Int)] = (1..=n).flat_map(a => (1..=a).map(b => (a, b)));

@cases(([3, 1, 2], [10, 20]) -> [13, 11, 12, 23, 21, 22])
pub fn every_sum(xs: List[Int], ys: List[Int]) -> List[Int] = ys.flat_map(y => xs.map(x => x + y));

@cases([[3, 1], [], [2, 9, 4]] -> [3, 0, 9])
pub fn tops(rows: List[List[Int]]) -> List[Int] = rows.map(r => r.max() else 0);

@cases([[1, 2], [3]] -> 2)
pub fn longest_row(rows: List[List[Int]]) -> Int = rows.map(it.size).max();

@why("the price a buyer pays reads the discount in force when it is asked")
@cases([Line("a", qty: 2, cents: 100), Line("b", qty: 1, cents: 50)] -> [200, 50])
pub fn prices(lines: List[Line]) -> List[Int] = lines.map(l => cost(l) - cost(l) * discount);

@why("the shop changes one number and every later price follows")
@uses(discount.write)
pub rule set_discount(n: 0..=1) = {
  discount = n;
}

test it_belongs_to_the_nearest_call = {
  let xs = [3, 1, 2];
  assert xs.sort(double(it)) == [1, 2, 3];
  assert xs.map(double(it + 1)) == [8, 4, 6];
  assert xs.filter(double(it) > 2).map(it - 1) == [2, 1];
  assert [[1, 2], [3]].map(row => row.map(it * 10)) == [[10, 20], [30]];
  assert [[1, 2], [3]].map(row => row.filter(it > 1).size) == [1, 1];
  assert xs.all(it > 0) and xs.any(it == 3) and xs.find(it < 3) == Some(1);
}

test a_lambda_reads_the_local_it_was_written_under = {
  var bonus = 1;
  let ys = [1, 2].map(it + bonus);
  bonus = 100;
  let zs = [1, 2].map(it + bonus);
  assert ys == [2, 3] and zs == [101, 102];
  let table = [10, 20, 30];
  assert [2, 0, 1].map(i => table[i]) == [30, 10, 20];
  assert [0, 1, 2].filter(i => table[i] > 15).map(i => table[i] + i) == [21, 32];
}

test a_lambda_reads_state_when_it_runs = {
  let lines = [Line("a", qty: 3, cents: 10)];
  assert prices(lines) == [30];
  set_discount(1);
  assert prices(lines) == [0];
  set_discount(0);
  assert prices(lines) == [30];
}

test fold_carries_any_value = {
  let words = ["one", "two", "three"];
  assert words.fold(0, (n, w) => n + w.size) == 11;
  assert words.fold((0, ""), (acc, w) => widest(acc, w: w)) == (5, "three");
  assert words.fold(Map(), (m, w) => m_with(m, w: w)) == Map(3 -> ["one", "two"], 5 -> ["three"]);
  assert words.fold([], (acc, w) => [w] + acc) == words.reversed();
}

fn widest(acc: (Int, Text), w: Text) -> (Int, Text) = match acc {
  (n, t) => if w.size > n then (w.size, w) else (n, t);
}

fn m_with(m: Map[Int, List[Text]], w: Text) -> Map[Int, List[Text]] = {
  var out = m;
  out[w.size] = (m[w.size] else []) + [w];
  return out;
}

test it_and_a_name_are_the_same_function(xs: List[-30..=30], k: -5..=5) = {
  assert xs.map(it * k) == xs.map(x => x * k);
  assert xs.filter(it > k) == xs.filter(x => x > k);
  assert xs.map(x => { return x * k; }) == xs.map(it * k);
  assert xs.fold(0, (a, x) => a + x * k) == xs.sum() * k;
  assert xs.flat_map(x => [x, k]).size == 2 * xs.size;
  assert xs.sort(x => x * k) == xs.sort(it * k);
}
