// f13-list-order pins: `sort` (stable; by key; `desc: true` keeps ties in
// their first order where `.reversed()` turns them round), `distinct` (keeps
// the earliest of equals), `zip` (pairs; uneven sizes fail `Uneven`),
// `group_by` (a Map in ascending key order, each group in list order).

type Card(rank: Int, suit: Text);

const hand: List[Card] = [
  Card(7, suit: "h"), Card(2, suit: "s"), Card(7, suit: "c"), Card(9, suit: "d"), Card(2, suit: "h"), Card(7, suit: "d"),
];

@cases([] -> [], [1] -> [1], [3, 1, 2] -> [1, 2, 3], [2, 1, 2, 1] -> [1, 1, 2, 2], [-1, -10, 5, 0] -> [-10, -1, 0, 5],
  [10, 9, 100] -> [9, 10, 100], [18446744073709551616, 9007199254740993, 9007199254740992] -> [9007199254740992, 9007199254740993, 18446744073709551616])
pub fn sorted(xs: List[Int]) -> List[Int] = xs.sort();

@cases(["b", "a", "C"] -> ["C", "a", "b"], ["10", "9", "1"] -> ["1", "10", "9"], ["ab", "a", ""] -> ["", "a", "ab"])
pub fn sorted_text(xs: List[Text]) -> List[Text] = xs.sort();

@cases(["ccc", "a", "bb", "dd", "e"] -> ["a", "e", "bb", "dd", "ccc"])
pub fn by_size(xs: List[Text]) -> List[Text] = xs.sort(it.size);

@cases([3, 1, 2] -> [3, 2, 1], [] -> [])
pub fn falling(xs: List[Int]) -> List[Int] = xs.sort(it, desc: true);

@cases([] -> [], [1, 1, 1] -> [1], [3, 1, 3, 2, 1] -> [3, 1, 2], [1, 2, 3] -> [1, 2, 3])
pub fn unique(xs: List[Int]) -> List[Int] = xs.distinct();

@cases(
  ([1, 2], ["a", "b"]) -> [(1, "a"), (2, "b")],
  ([], []) -> [],
)
pub fn paired(xs: List[Int], ys: List[Text]) -> List[(Int, Text)] = xs.zip(ys);

@cases(
  [] -> Map(),
  [1, 2, 3, 4, 5] -> Map(0 -> [3], 1 -> [1, 4], 2 -> [2, 5]),
  [5, 4, 3, 2, 1] -> Map(0 -> [3], 1 -> [4, 1], 2 -> [5, 2]),
  [3, 3] -> Map(0 -> [3, 3]),
)
pub fn by_three(xs: List[Int]) -> Map[Int, List[Int]] = xs.group_by(it mod 3);

fn glued(p: (Int, Text)) -> Text = match p {
  (n, t) => "{n}{t}";
}

fn step_up(p: (Int, Int)) -> Bool = match p {
  (a, b) => b == a + 1;
}

fn left(p: (Int, Int)) -> Int = match p {
  (a, _) => a;
}

fn suits(cs: List[Card]) -> Text = cs.map(it.suit).join("");

test sort_is_stable = {
  assert suits(hand.sort(it.rank)) == "shhcdd";
  assert hand.sort(it.rank).map(it.rank) == [2, 2, 7, 7, 7, 9];
  assert suits(hand.sort(it.suit)) == "cddhhs";
  assert hand.sort(it.suit).map(it.rank) == [7, 9, 7, 7, 2, 2];
}

test desc_keeps_ties_and_reversed_turns_them = {
  assert suits(hand.sort(it.rank, desc: true)) == "dhcdsh";
  assert suits(hand.sort(it.rank).reversed()) == "ddchhs";
  assert hand.sort(it.rank, desc: true).map(it.rank) == [9, 7, 7, 7, 2, 2];
}

test sort_by_two_keys = {
  assert hand.sort(c => (c.rank, c.suit)).map(c => "{c.rank}{c.suit}").join(" ") == "2h 2s 7c 7d 7h 9d";
  assert hand.sort(c => (c.suit, 0 - c.rank)).map(c => "{c.rank}{c.suit}").join(" ") == "7c 9d 7d 7h 2h 2s";
  assert hand.sort(it.suit).sort(it.rank).map(c => "{c.rank}{c.suit}").join(" ") == "2h 2s 7c 7d 7h 9d";
}

test distinct_keeps_the_earliest = {
  assert hand.map(it.rank).distinct() == [7, 2, 9];
  assert hand.map(it.suit).distinct() == ["h", "s", "c", "d"];
  assert (hand + hand).distinct() == hand;
  assert [Card(1, suit: "x"), Card(1, suit: "x"), Card(1, suit: "y")].distinct().size == 2;
}

test zip_refuses_uneven_lists = {
  paired([1, 2], ys: ["a"]) -> fail Uneven;
  paired([], ys: ["a"]) -> fail Uneven;
  paired([1], ys: ["a"]) -> [(1, "a")];
  assert ([1].zip([]) else []) == [];
}

test zip_gives_pairs_in_order = {
  let ps = [1, 2, 3].zip(["a", "b", "c"]);
  assert ps.size == 3;
  assert ps[0] == (1, "a") and ps[2] == (3, "c");
  assert ps.map(p => glued(p)).join("") == "1a2b3c";
}

test groups_keep_list_order_and_keys_ascend = {
  let g = hand.group_by(it.rank);
  assert g.keys == [2, 7, 9];
  assert suits(g[7]) == "hcd" and suits(g[2]) == "sh" and suits(g[9]) == "d";
  let s = hand.group_by(it.suit);
  assert s.keys == ["c", "d", "h", "s"];
  assert s["d"].map(it.rank) == [9, 7];
  assert s.values.map(it.size) == [1, 2, 2, 1];
}

test sorted_is_ordered_and_a_permutation(xs: List[-20..=20]) = {
  let ys = xs.sort();
  assert ys.size == xs.size and ys.sum() == xs.sum();
  assert (0..<ys.size).all(i => i == 0 or ys[i - 1] <= ys[i]);
  assert ys.sort() == ys;
  assert xs.reversed().sort() == ys;
  assert xs.sort(it, desc: true) == ys.reversed();
  assert xs.sort(0 - it) == ys.reversed();
  assert xs.all(x => x in ys);
}

test distinct_has_each_value_once(xs: List[-5..=5]) = {
  let ds = xs.distinct();
  assert ds.distinct() == ds;
  assert xs.all(x => ds.filter(it == x).size == 1);
  assert ds.size <= xs.size and ds.size <= 11;
  assert ds.size == 0 or ds.first == xs.first;
  assert ds.sort() == xs.sort().distinct();
}

test groups_partition_the_list(xs: List[-20..=20]) = {
  let g = xs.group_by(it mod 4);
  assert g.values.map(it.size).sum() == xs.size;
  assert g.keys.all(k => 0 <= k < 4 and g[k].size >= 1 and g[k].all(it mod 4 == k));
  assert g.keys.all(k => g[k] == xs.filter(it mod 4 == k));
  assert g.keys == g.keys.sort();
}

test zip_then_unzip(xs: List[Int]) = {
  let ps = xs.zip(xs.map(it + 1));
  assert ps.size == xs.size;
  assert ps.all(p => step_up(p));
  assert ps.map(p => left(p)) == xs;
}
