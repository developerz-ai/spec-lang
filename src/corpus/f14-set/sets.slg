// f14-set pins: a Set has each value once, iterates ascending whatever the
// order it was written or filled in, compares by content; `size list in
// contains filter map all any find sum min max sort`, `+` and `-` as union
// and difference, `insert` (already there: no change) and `remove` (absent:
// no change) as statements on a `var`, sets of records and of text.

type Point(x: Int, y: Int);

@cases(Set() -> [], Set(3, 1, 2) -> [1, 2, 3], Set(2, 2, 2) -> [2], Set(-1, 10, 9, -10) -> [-10, -1, 9, 10])
pub fn ascending(s: Set[Int]) -> List[Int] = s.list;

@cases(Set("b", "a", "B", "aa") -> ["B", "a", "aa", "b"], Set("10", "9") -> ["10", "9"])
pub fn ascending_text(s: Set[Text]) -> List[Text] = s.list;

@cases(Set() -> 0, Set(1, 1) -> 1, Set(1, 2) -> 2)
pub fn count(s: Set[Int]) -> Int = s.size;

@cases((Set(1, 2), Set(2, 3)) -> Set(1, 2, 3), (Set(), Set()) -> Set(), (Set(1), Set()) -> Set(1))
pub fn union(a: Set[Int], b: Set[Int]) -> Set[Int] = a + b;

@cases((Set(1, 2), Set(2, 3)) -> Set(1), (Set(1), Set()) -> Set(1), (Set(), Set(1)) -> Set(), (Set(1, 2), Set(1, 2)) -> Set())
pub fn minus(a: Set[Int], b: Set[Int]) -> Set[Int] = a - b;

@cases((Set(1, 2, 3), Set(2, 3, 4)) -> Set(2, 3), (Set(1), Set(2)) -> Set())
pub fn common(a: Set[Int], b: Set[Int]) -> Set[Int] = a.filter(it in b);

@cases(Set(1, 2, 3, 4) -> Set(0, 1), Set() -> Set(), Set(-1, 1) -> Set(1))
pub fn parities(s: Set[Int]) -> Set[Int] = s.map(it mod 2);

@cases([3, 1, 3, 2, 1] -> [1, 2, 3], [] -> [])
pub fn through_a_set(xs: List[Int]) -> List[Int] = {
  var s: Set[Int] = Set();
  for x in xs { s.insert(x); }
  return s.list;
}

test a_set_is_its_content = {
  assert Set(1, 2, 3) == Set(3, 2, 1);
  assert Set(1, 1, 2) == Set(1, 2);
  assert Set(1) != Set(2) and Set(1) != Set(1, 2) and Set() != Set(0);
  assert Set(Point(1, y: 2), Point(1, y: 2)).size == 1;
  assert Set(Point(2, y: 0), Point(1, y: 9), Point(1, y: 2)).list == [Point(1, y: 2), Point(1, y: 9), Point(2, y: 0)];
  assert Set(Set(2, 1), Set(1, 2)).size == 1;
}

test insert_and_remove_are_quiet = {
  var s = Set(2);
  let before = s;
  s.insert(1);
  s.insert(2);
  s.insert(3);
  assert s == Set(1, 2, 3) and s.size == 3;
  s.remove(2);
  s.remove(2);
  s.remove(99);
  assert s.list == [1, 3];
  assert before == Set(2);
  assert 1 in s and s.contains(3) and not (2 in s) and not s.contains(99);
}

test the_function_names_follow_ascending_order = {
  let s = Set(40, 10, 30, 20);
  assert s.find(it > 15) == Some(20);
  assert s.find(it > 99) == none;
  assert s.filter(it > 15).list == [20, 30, 40];
  assert s.all(it >= 10) and not s.all(it > 10);
  assert s.any(it == 40) and not s.any(it == 41);
  assert s.sum() == 100 and s.sum(it * 2) == 200;
  assert s.min() == 10 and s.max() == 40;
  assert s.max(it mod 30) == 20;
  assert s.min(it mod 30) == 30;
  assert s.sort(0 - it) == [40, 30, 20, 10];
  assert s.sort(it mod 20) == [20, 40, 10, 30];
  assert s.map(it mod 20) == Set(0, 10);
  assert s.map(n => "{n}").list == ["10", "20", "30", "40"];
}

test loops_over_a_set_ascend = {
  var seen: List[Text] = [];
  for t in Set("pear", "fig", "kiwi", "Fig") { seen.push(t); }
  assert seen == ["Fig", "fig", "kiwi", "pear"];
}

test set_algebra(a: Set[-8..=8], b: Set[-8..=8]) = {
  assert a + b == b + a;
  assert (a + b).size == a.size + b.size - a.filter(it in b).size;
  assert (a - b) + a.filter(it in b) == a;
  assert (a - b).all(x => x in a and not (x in b));
  assert a + a == a and a - a == Set();
  assert (a + b) - b == a - b;
  assert a.list == a.list.sort() and a.list.distinct() == a.list;
  assert a.list.size == a.size;
}

test a_list_through_a_set(xs: List[-8..=8]) = {
  assert through_a_set(xs) == xs.distinct().sort();
  assert through_a_set(xs + xs) == through_a_set(xs);
}
