// invites: port of docs/pocs/03-invites-and-webhooks (invites only, as the design says).
// Pins a guard whose condition fails while it is evaluated (`invites[id]` on a missing id
// gives that guard's error), `and` stopping when decided, `@pii`/`@secret` labels on record
// fields, two maps and a set written by three rules, and laws over `t.states` and `t.steps`.
// `flow`, `event`, `@access`, the clock and `random.token()` are cut; see README.md.

type InviteId = 1..=4;
type UserId = 1..=4;

type Status = Pending | Accepted | Revoked | Expired;
type Invite(@pii email: Text, @secret token: Text, status: Status = Pending);

state invites: Map[InviteId, Invite];
state members: Map[InviteId, UserId];
state admins: Set[UserId];

fn admin(by: UserId) -> Bool = by in admins;

@why("a wrong token and a missing invite give the same answer")
@uses(invites.write, members.write)
@guard(id in invites and invites[id].token == token else NotFound)
@guard(invites[id].status == Pending else Gone)
pub rule accept(by: UserId, id: InviteId, token: Text) = {
  invites[id].status = Accepted;
  members[id] = by;
}

@why("an admin takes back an invite nobody has used")
@uses(invites.write, admins.read)
@guard(admin(by) else NotFound)
@guard(invites[id].status == Pending else Gone)
pub rule revoke(by: UserId, id: InviteId) = {
  invites[id].status = Revoked;
}

@why("a resent invite has a new link and a dead old link")
@uses(invites.write, admins.read)
@guard(admin(by) else NotFound)
@guard(invites[id].status == Pending else Gone)
pub rule resend(by: UserId, id: InviteId, fresh: Text) = {
  invites[id].token = fresh;
  invites[id].status = Pending;
}

@why("membership exists only through an accepted invite")
law member_means_accepted(t: Trace[accept | revoke | resend]) =
  t.states.all(s => s.members.keys.all(i => i in s.invites and s.invites[i].status == Accepted));

@why("an invite that left Pending never moves again")
law closed_stays_closed(t: Trace[accept | revoke | resend], i: InviteId) =
  t.steps.all(s => i in s.before.invites and s.before.invites[i].status != Pending implies
    s.after.invites[i].status == s.before.invites[i].status);

const boss: UserId = 1;
const ana: UserId = 2;
const eve: UserId = 3;
const i1: InviteId = 1;

@given(admins -> Set(boss), invites -> Map(i1 -> Invite("ana@example.com", token: "t1")))
test invited = {
  assert invites[i1].status == Pending;
}

@given(invited)
test accepted_once = {
  accept(ana, id: i1, token: "t1");
  accept(eve, id: i1, token: "t1") -> fail Gone;
  revoke(boss, id: i1) -> fail Gone;
  assert members == Map(i1 -> ana);
}

@given(invited)
test wrong_token_looks_like_no_invite = {
  accept(eve, id: i1, token: "guess") -> fail NotFound;
  accept(eve, id: 4, token: "t1") -> fail NotFound;
}

@given(invited)
test resending_kills_the_old_link = {
  resend(boss, id: i1, fresh: "t2");
  assert invites[i1].status == Pending;
  accept(ana, id: i1, token: "t1") -> fail NotFound;
  accept(ana, id: i1, token: "t2");
}

@given(invited)
test only_admins = {
  revoke(eve, id: i1) -> fail NotFound;
  resend(eve, id: i1, fresh: "t2") -> fail NotFound;
}

@given(invited)
test a_missing_invite_is_gone_to_an_admin = {
  revoke(boss, id: 4) -> fail Gone;
}
