// f07-text-size pins: `Text.size` counts code points (not bytes, not UTF-16
// units, not grapheme clusters), `bytes` is UTF-8, `take` and `drop` cut by
// code point, equality compares code points with no normalisation, and `<`
// orders by code point (not by UTF-16 unit).

@cases(
  "" -> 0,
  "abc" -> 3,
  "é" -> 1,
  "e\u{301}" -> 2,
  "日本語" -> 3,
  "😀" -> 1,
  "👨‍👩‍👧" -> 5,
  "🇷🇴" -> 2,
  "a😀b" -> 3,
  "\u{10FFFF}" -> 1,
  "\u{0}" -> 1,
  "\n\t" -> 2,
)
pub fn points(t: Text) -> Int = t.size;

@cases(
  "" -> 0,
  "abc" -> 3,
  "é" -> 2,
  "e\u{301}" -> 3,
  "日本語" -> 9,
  "😀" -> 4,
  "👨‍👩‍👧" -> 18,
  "\u{7F}" -> 1,
  "\u{80}" -> 2,
  "\u{7FF}" -> 2,
  "\u{800}" -> 3,
  "\u{FFFF}" -> 3,
  "\u{10000}" -> 4,
)
pub fn octets(t: Text) -> Int = t.bytes.size;

@cases(
  "A" -> [65],
  "é" -> [195, 169],
  "€" -> [226, 130, 172],
  "😀" -> [240, 159, 152, 128],
  "a€" -> [97, 226, 130, 172],
  "" -> [],
)
pub fn utf8(t: Text) -> List[Int] = t.bytes.map(it);

@cases(
  ("héllo", 2) -> "hé",
  ("😀😀😀", 1) -> "😀",
  ("e\u{301}x", 1) -> "e",
  ("abc", 0) -> "",
  ("abc", 3) -> "abc",
  ("abc", 99) -> "abc",
  ("", 2) -> "",
)
pub fn head(t: Text, n: Int) -> Text = t.take(n);

@cases(
  ("héllo", 2) -> "llo",
  ("😀a😀", 1) -> "a😀",
  ("e\u{301}x", 1) -> "\u{301}x",
  ("abc", 0) -> "abc",
  ("abc", 3) -> "",
  ("abc", 99) -> "",
)
pub fn tail(t: Text, n: Int) -> Text = t.drop(n);

@cases(
  ("a", "b") -> true,
  ("b", "a") -> false,
  ("a", "a") -> false,
  ("", "a") -> true,
  ("a", "ab") -> true,
  ("Z", "a") -> true,
  ("z", "é") -> true,
  ("\u{FFFF}", "\u{10000}") -> true,
  ("\u{FF5E}", "😀") -> true,
  ("10", "9") -> true,
)
pub fn before(a: Text, b: Text) -> Bool = a < b;

test nothing_is_normalised = {
  assert "é" != "e\u{301}";
  assert "é" == "\u{E9}";
  assert "Å" != "\u{212B}";
  assert "a" != "A";
  assert "" == "";
  assert "a " != "a";
}

test sorting_text_is_by_code_point = {
  assert ["b", "a", "B", "", "ab", "é", "😀", "\u{FFFD}"].sort() == ["", "B", "a", "ab", "b", "é", "\u{FFFD}", "😀"];
  assert ["10", "9", "1"].sort() == ["1", "10", "9"];
}

test take_and_drop_split_by_code_point(t: Text, n: 0..=20) = {
  assert t.take(n).size == n.min(t.size);
  assert t.drop(n).size == (t.size - n).max(0);
  assert "{t.take(n)}{t.drop(n)}" == t;
  assert t.bytes.size >= t.size;
  assert t.bytes.size <= 4 * t.size;
}
