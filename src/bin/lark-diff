#!/usr/bin/env bash
# Differential fuzz of the parser against the Lark reference grammar.
# Usage: src/bin/lark-diff [seed] [count]   (needs uv; not part of the gate)
# Mutates every slg fence and .slg file by token deletions, insertions,
# swaps and duplications, then compares which mutants each parser rejects.
set -euo pipefail
cd "$(dirname "$0")/.."
seed=${1:-1}
count=${2:-5000}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cargo build -q --release -p spec-lang-cli
uv run -q --with 'lark[interegular]' python - "$work" "$seed" "$count" <<'EOF'
import pathlib, random, re, sys
from lark import Lark
from lark.exceptions import LarkError
root = pathlib.Path("..").resolve()
out, seed, n = pathlib.Path(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3])
doc = (root / "docs/idea/25-grammar.md").read_text()
grammar = re.search(r"```text\n(// spec-lang surface grammar.*?)```", doc, re.S).group(1)
parser = Lark(grammar, start="file", parser="lalr", strict=True)
fence = re.compile(r"^```slg\n(.*?)^```", re.S | re.M)
blocks = [m.group(1) for f in sorted((root / "docs").rglob("*.md")) for m in fence.finditer(f.read_text())]
blocks += [f.read_text() for f in sorted((root / "pocs/todo-app/src").rglob("*.slg"))]
inserts = ["else", "then", "where", "mod", "band", "if", "fail", "not", "in", "and", "match", "let", "use", "pub",
           "machine", "foreign", "re", "=>", "->", "→", "==", "=", ";", "{", "}", "(", ")", "[", "]", ",", ":", ".",
           "|", "^", "²", "..=", "±", "@", "?", '"x"', 're"y"', "1e5", "0x", "x", " ", "\n", "¬", "∈", "own",
           "return", "for", "while", "var"]
tok = re.compile(r'\w+|"[^"\n]*"|\.\.=|\.\.<|->|=>|==|!=|<=|>=|\S|\s+')
rnd = random.Random(seed)
rejected = []
for i in range(n):
    toks = tok.findall(rnd.choice(blocks)) or [" "]
    for _ in range(rnd.randint(1, 3)):
        if not toks:
            break
        k, op = rnd.randrange(len(toks)), rnd.randrange(5)
        if op == 0: del toks[k]
        elif op == 1: toks.insert(k, rnd.choice(inserts))
        elif op == 2: toks[k] = rnd.choice(inserts)
        elif op == 3 and k + 1 < len(toks): toks[k], toks[k + 1] = toks[k + 1], toks[k]
        elif op == 4: toks.insert(k, toks[k])
    src = "".join(toks)
    name = f"s{i:05}.slg"
    (out / name).write_text(src)
    try:
        parser.parse(src)
    except LarkError:
        rejected.append(name)
(out / "lark.txt").write_text("".join(f"{r}\n" for r in rejected))
EOF
target/release/spec-lang parse "$work" 2>&1 >/dev/null | grep -o 's[0-9]*\.slg' | sort -u > "$work/mine.txt" || true
lark=$(wc -l < "$work/lark.txt"); mine=$(wc -l < "$work/mine.txt")
if diff "$work/lark.txt" "$work/mine.txt" > "$work/diff.txt"; then
  echo "seed $seed: $count mutants, Lark rejects $lark, spec-lang rejects $mine: same set"
else
  echo "seed $seed: DISAGREE on:"; cat "$work/diff.txt"; exit 1
fi
