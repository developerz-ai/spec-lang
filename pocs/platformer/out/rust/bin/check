#!/usr/bin/env bash
# Projected by hand from app SkyhopRust (src/apps/rust.slg). Stand-in for spec-lang build output; change the spec, not this file.
# The gate: format, lints, tests (under a virtual X server, for the tests that open a window), then the release build.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
[ -f ../../vendor/raylib/lib/libraylib.so ] || ../../bin/raylib
cargo fmt --check
cargo clippy --locked --all-targets -- -D warnings
if command -v xvfb-run >/dev/null; then
  xvfb-run -a cargo test --locked
else
  echo "xvfb-run not found: window tests will skip with a reason" >&2
  cargo test --locked
fi
bin/build
