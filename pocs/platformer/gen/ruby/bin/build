#!/usr/bin/env bash
# Generated by spec-lang build from app SkyhopRuby (apps/ruby.slg). Do not edit: change the spec and build again.
# Ruby has no compile step: the build makes the executable runnable and proves every product file parses without a warning.
set -euo pipefail
cd "$(dirname "$0")/.."

# The runtime's gems go into vendor/bundle with a load path that needs no RubyGems.
bundle config set --local path vendor/bundle >/dev/null
bundle install --quiet --standalone default
chmod +x exe/skyhop bin/test
while IFS= read -r file; do
  if ! report=$(ruby -wc "$file" 2>&1) || [ "$report" != "Syntax OK" ]; then
    printf '%s: %s\n' "$file" "$report" >&2
    exit 1
  fi
done < <(find exe lib -type f -name '*.rb' -o -type f -path 'exe/*' | sort)
echo "built exe/skyhop"
