use game;
use hop.world;
use hop.render;
use hop.screen;

@why("the game as one native binary, calling raylib directly")
@target(cpp)
@bin("skyhop")
@window(960, 540, "Skyhop")
app SkyhopCpp(start: world.start, tick: world.step, input: screen.read_pad, frame: screen.present, dump: render.dump, report: world.summary);
