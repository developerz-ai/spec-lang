use game;
use hop.world;
use hop.render;
use hop.screen;

@why("the game in Ruby, through a foreign function interface")
@target(ruby)
@bin("skyhop")
@window(960, 540, "Skyhop")
app SkyhopRuby(start: world.start, tick: world.step, input: screen.read_pad, frame: screen.present, dump: render.dump, report: world.summary);
