// hop.laws: what holds after any sequence of starts and steps, whatever the pad does.

use hop.world;
use hop.geom;
use hop.physics;
use hop.model.Mode;

type Play = world.start | world.step;

@why("the hero is never inside a solid")
law never_inside_a_solid(t: Trace[Play]) =
  t.states.all(w => w.stage.solids.all(s => not geom.overlaps(physics.body(w.player.at), b: s.box)));

@why("speeds stay in bounds, so a body never passes through a solid in one tick")
law speed_is_bounded(t: Trace[Play]) =
  t.states.all(w => w.player.vel.x.abs() <= physics.run_speed and w.player.vel.z.abs() <= physics.run_speed
    and 0 - physics.max_fall <= w.player.vel.y <= physics.jump_speed);

@why("a gem once taken stays taken until the level starts again")
law taken_only_grows(t: Trace[world.step]) =
  t.steps.all(s => s.before.taken.all(g => g in s.after.taken));

@why("lives only go down during play")
law lives_never_rise(t: Trace[world.step]) =
  t.steps.all(it.after.lives <= it.before.lives);

@why("no lives left is exactly a lost game")
law lost_means_no_lives(t: Trace[Play]) =
  t.states.all(w => (w.lives == 0) == (w.mode == Lost));

@why("a finished game is final: a step is refused and nothing moves")
law over_is_final(t: Trace[world.step]) =
  t.steps.all(s => s.before.mode != Playing implies (s.reply.is(Err(_)) and s.after == s.before));

@why("time moves one tick per accepted step")
law one_tick_per_step(t: Trace[world.step]) =
  t.steps.all(s => s.reply.is(Ok(_)) implies s.after.ticks == s.before.ticks + 1);

@why("a taken gem is one the level has")
law taken_are_real_gems(t: Trace[Play]) =
  t.states.all(w => w.taken.all(n => w.stage.gems.any(it.no == n)));
