// hop.geom: points and boxes in sub-metres. Pure; no state, no effects.

@why("4096 m either way from the origin, so every coordinate is exact as an f32 at the C edge")
pub type Sub = -1048576..=1048576;

@why("256 sub-metres to the metre: a power of two, so metres are exact binary fractions")
pub const unit: Int = 256;

pub type Vec3(x: Sub, y: Sub, z: Sub);

@why("lo is the corner nearest minus infinity on every axis")
pub type Box(lo: Vec3, hi: Vec3);

@cases((Vec3(1, 2, 3), Vec3(10, 20, 30)) -> Vec3(11, 22, 33))
pub fn plus(a: Vec3, b: Vec3) -> Vec3 = Vec3(a.x + b.x, y: a.y + b.y, z: a.z + b.z);

pub fn minus(a: Vec3, b: Vec3) -> Vec3 = Vec3(a.x - b.x, y: a.y - b.y, z: a.z - b.z);

pub fn scaled(v: Vec3, k: Int) -> Vec3 = Vec3(v.x * k, y: v.y * k, z: v.z * k);

pub fn shifted(b: Box, by: Vec3) -> Box = Box(plus(b.lo, b: by), hi: plus(b.hi, b: by));

@why("a body is placed by the centre of its base: its feet")
@cases((Vec3(0, 0, 0), Vec3(64, 192, 64)) -> Box(Vec3(-64, 0, -64), hi: Vec3(64, 192, 64)))
pub fn around_feet(feet: Vec3, half: Vec3) -> Box =
  Box(Vec3(feet.x - half.x, y: feet.y, z: feet.z - half.z), hi: Vec3(feet.x + half.x, y: feet.y + half.y, z: feet.z + half.z));

@why("a gem is placed by its centre")
pub fn around_centre(c: Vec3, half: Int) -> Box =
  Box(Vec3(c.x - half, y: c.y - half, z: c.z - half), hi: Vec3(c.x + half, y: c.y + half, z: c.z + half));

@why("solids block only when they share volume: a body standing on a floor touches it and is not inside it")
@cases(
  (Box(Vec3(0, 0, 0), hi: Vec3(2, 2, 2)), Box(Vec3(1, 1, 1), hi: Vec3(3, 3, 3))) -> true,
  (Box(Vec3(0, 0, 0), hi: Vec3(2, 2, 2)), Box(Vec3(2, 0, 0), hi: Vec3(4, 2, 2))) -> false,
)
pub fn overlaps(a: Box, b: Box) -> Bool =
  a.lo.x < b.hi.x and b.lo.x < a.hi.x and a.lo.y < b.hi.y and b.lo.y < a.hi.y and a.lo.z < b.hi.z and b.lo.z < a.hi.z;

@why("pickups and hits count a touch, faces included: the same test raylib's CheckCollisionBoxes makes")
@cases(
  (Box(Vec3(0, 0, 0), hi: Vec3(2, 2, 2)), Box(Vec3(2, 0, 0), hi: Vec3(4, 2, 2))) -> true,
  (Box(Vec3(0, 0, 0), hi: Vec3(2, 2, 2)), Box(Vec3(3, 0, 0), hi: Vec3(4, 2, 2))) -> false,
)
pub fn touches(a: Box, b: Box) -> Bool =
  a.lo.x <= b.hi.x and b.lo.x <= a.hi.x and a.lo.y <= b.hi.y and b.lo.y <= a.hi.y and a.lo.z <= b.hi.z and b.lo.z <= a.hi.z;

@why("the footprints meet strictly: standing needs some floor under the feet, not an edge")
pub fn over(a: Box, b: Box) -> Bool = a.lo.x < b.hi.x and b.lo.x < a.hi.x and a.lo.z < b.hi.z and b.lo.z < a.hi.z;

@why("back and forth along a path without division: 0 up to n, then down to 0, period 2n")
@cases((0, 4) -> 0, (3, 4) -> 3, (4, 4) -> 4, (5, 4) -> 3, (8, 4) -> 0, (9, 4) -> 1)
pub fn triangle(t: Int, n: Int) -> Int = {
  let p = t mod (2 * n);
  return if p <= n then p else 2 * n - p;
}

@cases((0, 3, 2) -> 2, (5, 3, 2) -> 3, (5, 0, 2) -> 3, (-5, 0, 1) -> -4)
pub fn approach(v: Int, target: Int, step: Int) -> Int =
  if v < target then (v + step).min(target) else (v - step).max(target);

@cases(Vec3(1, -2, 3) -> "1,-2,3")
pub fn vec_text(v: Vec3) -> Text = "{v.x},{v.y},{v.z}";
