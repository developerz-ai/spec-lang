#!/usr/bin/env -S ruby --disable-gems
# frozen_string_literal: true

# Projected by hand from app TodoRuby with @bin("todo") (src/apps/ruby.slg). Stand-in for spec-lang build output; change the spec, not this file.

# The program uses the standard library only, so RubyGems is never loaded (the shebang) and each run
# requires only the files its command needs.
require_relative "../lib/todo/cli"

# Die quietly, as other tools do, when the reader of our output has gone away.
Signal.trap("PIPE", "SYSTEM_DEFAULT")
$stdout.binmode
$stderr.binmode
exit Todo::CLI.run(ARGV, env: ENV, out: $stdout, err: $stderr)
