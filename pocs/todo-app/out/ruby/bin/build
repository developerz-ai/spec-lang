#!/usr/bin/env bash
# Projected by hand from the build of the ruby target (docs/contract.md section 4). Stand-in for spec-lang build output; change the spec, not this file.
# Ruby has no compile step: the build makes exe/todo executable and proves every product file parses without a warning.
set -euo pipefail
cd "$(dirname "$0")/.."

chmod +x exe/todo
while IFS= read -r file; do
  if ! report=$(ruby -wc "$file" 2>&1) || [ "$report" != "Syntax OK" ]; then
    printf '%s: %s\n' "$file" "$report" >&2
    exit 1
  fi
done < <(find exe lib -type f | sort)
echo "built exe/todo"
