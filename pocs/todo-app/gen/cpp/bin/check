#!/usr/bin/env bash
# Generated by spec-lang build --target cpp from app TodoCpp, @bin (src/apps/cpp.slg:4). Do not edit: change the spec.
# The gate: format, build with every warning an error, every test.
set -euo pipefail
cd "$(dirname "$0")/.."
mapfile -t sources < <(find include src tests -name '*.hpp' -o -name '*.cpp' | sort)
clang-format --dry-run --Werror "${sources[@]}"
bin/build
ctest --test-dir build --output-on-failure
