#!/usr/bin/env bash
# Generated by spec-lang build from app TodoRuby (apps/ruby.slg). Do not edit: change the spec and build again.
# The whole gate: `ruby -w` on every file, build, the program's own checks, the runtimes' tests. Any warning fails it.
set -euo pipefail
cd "$(dirname "$0")/.."

bundle check >/dev/null || bundle install --quiet

while IFS= read -r file; do
  if ! report=$(ruby -wc "$file" 2>&1) || [ "$report" != "Syntax OK" ]; then
    printf '%s: %s\n' "$file" "$report" >&2
    exit 1
  fi
done < <(find Gemfile bin/test exe lib test -type f | sort)

bin/build

log=$(mktemp)
trap 'rm -f "$log"' EXIT

# Every check of the program, as `spec-lang test` names and judges it: none may fail.
ruby -w bin/test 2>&1 | tee "$log" | grep -v '"status": "pass"' || true
if grep -q -e '"status": "fail"' -e 'warning:' "$log" || ! grep -q '"status"' "$log"; then
  echo "the program's checks did not all pass" >&2
  exit 1
fi
echo "$(grep -c '"status": "pass"' "$log") checks pass, $(grep -c '"status": "blocked"' "$log" || true) blocked"

# The runtimes' own tests. Those that draw need a window: a virtual X server when one can be started.
xvfb=()
if [ -z "${DISPLAY:-}" ] && command -v xvfb-run >/dev/null; then xvfb=(xvfb-run -a); fi
"${xvfb[@]}" bundle exec ruby -w -Ilib -Itest -e 'Dir["test/**/*_test.rb"].sort.each { |file| require File.expand_path(file) }' 2>&1 | tee "$log"
if grep -q 'warning:' "$log"; then
  echo "the tests ran with warnings" >&2
  exit 1
fi
