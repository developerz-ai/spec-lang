#!/usr/bin/env bash
# Generated by spec-lang build from app TodoRuby (apps/ruby.slg). Do not edit: change the spec and build again.
# Ruby has no compile step: the build makes the executable runnable and proves every product file parses without a warning.
set -euo pipefail
cd "$(dirname "$0")/.."

chmod +x exe/todo bin/test
while IFS= read -r file; do
  if ! report=$(ruby -wc "$file" 2>&1) || [ "$report" != "Syntax OK" ]; then
    printf '%s: %s\n' "$file" "$report" >&2
    exit 1
  fi
done < <(find exe lib -type f -name '*.rb' -o -type f -path 'exe/*' | sort)
echo "built exe/todo"
