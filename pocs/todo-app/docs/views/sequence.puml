@startuml
title todo.tests.scenarios.done_and_reopen_move_once
actor "done_and_reopen_move_once" as caller
participant "todo.board" as m_todo_board
database "tasks" as s_tasks
database "next_no" as s_next_no
boundary "out" as x_out
note over s_tasks, s_next_no : given three_open_one_done
