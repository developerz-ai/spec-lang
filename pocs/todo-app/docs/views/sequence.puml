@startuml
title todo.tests.scenarios.numbers_start_at_one
actor "numbers_start_at_one" as caller
participant "todo.board" as m_todo_board
database "tasks" as s_tasks
database "next_no" as s_next_no
boundary "out" as x_out
caller -> m_todo_board : board.add(<U+0022>milk<U+0022>)
m_todo_board -> s_tasks : write
m_todo_board -> s_next_no : read, write
m_todo_board -> x_out : line
m_todo_board --> caller : 1
caller -> m_todo_board : board.add(<U+0022>bread<U+0022>, tags: Set(<U+0022>shop<U+0022>, <U+0022>home<U+0022>))
m_todo_board -> s_tasks : write
m_todo_board -> s_next_no : read, write
m_todo_board -> x_out : line
m_todo_board --> caller : 2
note over caller : assert out.text == <U+0022>added 1<U+005C>nadded 2<U+005C>n<U+0022>
@enduml

