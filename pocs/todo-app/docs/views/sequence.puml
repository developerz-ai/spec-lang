@startuml
title todo.tests.scenarios.unknown_numbers_are_refused
actor "unknown_numbers_are_refused" as caller
participant "todo.board" as m_todo_board
database "tasks" as s_tasks
database "next_no" as s_next_no
boundary "out" as x_out
note over caller : for any no: TaskNo
note over s_tasks, s_next_no : given three_open_one_done
opt no <= 4
note over caller : return
end
caller -> m_todo_board : board.done(no)
m_todo_board -> s_tasks : read
m_todo_board --x caller : fail NoTask
caller -> m_todo_board : board.reopen(no)
m_todo_board -> s_tasks : read
m_todo_board --x caller : fail NoTask
caller -> m_todo_board : board.rename(no, title: <U+0022>x<U+0022>)
m_todo_board -> s_tasks : read
m_todo_board --x caller : fail NoTask
caller -> m_todo_board : board.remove(no)
m_todo_board -> s_tasks : read
m_todo_board --x caller : fail NoTask
note over caller : assert out.text == <U+0022><U+0022>
@enduml
